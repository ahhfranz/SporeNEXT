{
  "name": "spore-next",
  "productName": "Spore NEXT",
  "private": true,
  "version": "2.0.9",
  "description": "Spore NEXT Launcher - Mod Manager",
  "author": "Spore NEXT",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "dist": "npm run build && electron-builder build --win --config electron-builder.json --publish always",
    "sync-mods": "node scripts/syncMods.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jimp": "^1.6.1",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  }
}